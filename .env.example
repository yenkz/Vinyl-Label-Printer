# Tus datos personales. Copiá este archivo como ".env" y completalo:
#     cp .env.example .env
# El .env queda fuera de git (.gitignore), así que tus tokens no se
# comparten aunque subas el proyecto a GitHub.

# Token de Discogs: https://www.discogs.com/settings/developers
#   -> "Generate new token" y pegalo acá.
DISCOGS_USER_TOKEN=

# Tu usuario de Discogs (el que aparece en la URL de tu perfil).
DISCOGS_USERNAME=

# OPCIONAL. API key de https://getsongbpm.com/api — los BPM se
# buscan primero en Deezer (gratis, sin clave), así que esto casi
# nunca hace falta. Si no la tenés, dejalo vacío.
GETSONGBPM_API_KEY=

# OPCIONAL. App de Spotify, el último respaldo de la cadena de
# fuentes (Discogs -> Beatport -> Bandcamp -> Spotify): completa la
# tapa, duraciones e ISRC que falten después de los otros pasos.
# Creá una app gratis en https://developer.spotify.com/dashboard y
# pegá acá sus credenciales.
# Ojo: esto NO trae BPM (Spotify lo bloqueó para apps nuevas en 2024).
# Beatport y Bandcamp no necesitan credenciales: no hay nada que
# configurar para esos pasos.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
