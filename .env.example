# Your personal data. Copy this file as ".env" and fill it in:
#     cp .env.example .env
# The .env file is excluded from git (.gitignore), so your tokens are
# not shared even if you push the project to GitHub.

# Discogs token: https://www.discogs.com/settings/developers
#   -> "Generate new token" and paste it here.
DISCOGS_USER_TOKEN=

# Your Discogs username (the one in your profile URL).
DISCOGS_USERNAME=

# OPTIONAL. Spotify app, the final fallback in the source chain
# (Discogs -> Beatport -> Bandcamp -> Spotify): fills in cover,
# durations, and ISRC missing after other steps.
# Create a free app at https://developer.spotify.com/dashboard and
# paste its credentials here.
# Note: this does NOT fetch BPM (Spotify blocked it for new apps in 2024).
# Beatport and Bandcamp don't need credentials: nothing to configure
# for those steps.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OPTIONAL. Download digital copies of your collection from Soulseek
# (make download). This talks to a local slskd daemon — see the README
# section "Download digital copies (Soulseek)" for how to install and
# start it. Leave these empty if you don't use that feature.
#
# The API key you set in slskd's own config file (slskd.yml, under
# web.authentication.api_keys). It authorizes this project to drive slskd.
SLSKD_API_KEY=
# Where slskd is listening. The default is fine if you run it on this Mac.
SLSKD_HOST=http://localhost:5030
# Folder slskd saves finished downloads to. Point slskd's "downloads"
# directory at this SAME path so we can move files into your library.
SLSKD_DOWNLOADS_DIR=~/Music/Vinyl/_incoming
# Where your organized digital library is built (one folder per record).
MUSIC_DIR=~/Music/Vinyl
