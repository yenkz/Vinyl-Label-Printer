# Tus datos personales. Copiá este archivo como ".env" y completalo:
#     cp .env.example .env
# El .env queda fuera de git (.gitignore), así que tus tokens no se
# comparten aunque subas el proyecto a GitHub.

# Token de Discogs: https://www.discogs.com/settings/developers
#   -> "Generate new token" y pegalo acá.
DISCOGS_USER_TOKEN=

# Tu usuario de Discogs (el que aparece en la URL de tu perfil).
DISCOGS_USERNAME=

# OPCIONAL. API key de https://getsongbpm.com/api — los BPM se
# buscan primero en Deezer (gratis, sin clave), así que esto casi
# nunca hace falta. Si no la tenés, dejalo vacío.
GETSONGBPM_API_KEY=
